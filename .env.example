NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI-compatible chat API for the customer order assistant.
# The key stays on the server. Leave AI_API_KEY empty to keep the assistant unavailable.
# AvalAI example: AI_BASE_URL=https://api.avalai.ir/v1
# AI_MODEL is the catalog id, lowercase with hyphens, such as gpt-5.4-nano. A display name with spaces is rejected.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
